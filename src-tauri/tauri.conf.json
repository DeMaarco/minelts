{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "minelts",
  "version": "0.1.0",
  "identifier": "com.minelts.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "minelts",
        "width": 900,
        "height": 600,
        "minWidth": 900,
        "minHeight": 600,
        "maxWidth": 900,
        "maxHeight": 600,
        "resizable": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
